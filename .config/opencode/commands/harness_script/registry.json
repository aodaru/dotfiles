{
  "languages": {
    "python": {
      "lang": "python",
      "runtime": "python3",
      "runtime_check": "command -v python3",
      "version_check": "python3 --version",
      "min_version": "3.9",
      "test_runner": "python3 -m unittest discover -s tests -v",
      "test_framework": "unittest",
      "file_ext": ".py",
      "style_guide": "PEP 8",
      "dep_file": "requirements.txt",
      "dep_install": "pip install",
      "run_cmd_prefix": "python3 -m",
      "dev_cmd": "python3 -m src.cli",
      "build_cmd": "python3 -m py_compile src/",
      "lint_cmd": "python3 -m py_compile src/",
      "init_cmd": "python3 -m unittest discover -s tests -q",
      "gitignore_extra": "__pycache__/\n*.pyc\n*.pyo\n.venv/"
    },
    "javascript-node": {
      "lang": "javascript",
      "runtime": "node",
      "runtime_check": "command -v node",
      "version_check": "node --version",
      "min_version": "18",
      "test_runner": "npx vitest run",
      "test_framework": "vitest",
      "file_ext": ".js",
      "style_guide": "ESLint + Prettier",
      "dep_file": "package.json",
      "dep_install": "npm install",
      "run_cmd_prefix": "node",
      "dev_cmd": "npm run dev",
      "build_cmd": "npm run build",
      "lint_cmd": "npx eslint src/",
      "init_cmd": "npx vitest run --reporter=verbose",
      "gitignore_extra": "node_modules/\npackage-lock.json\n.env"
    },
    "javascript-bun": {
      "lang": "javascript",
      "runtime": "bun",
      "runtime_check": "command -v bun",
      "version_check": "bun --version",
      "min_version": "1.0",
      "test_runner": "bun test",
      "test_framework": "bun:test",
      "file_ext": ".js",
      "style_guide": "ESLint + Prettier",
      "dep_file": "package.json",
      "dep_install": "bun install",
      "run_cmd_prefix": "bun",
      "dev_cmd": "bun run dev",
      "build_cmd": "bun run build",
      "lint_cmd": "bunx eslint src/",
      "init_cmd": "bun test",
      "gitignore_extra": "node_modules/\nbun.lockb\n.env"
    },
    "typescript-node": {
      "lang": "typescript",
      "runtime": "node",
      "runtime_check": "command -v node",
      "version_check": "node --version",
      "min_version": "18",
      "test_runner": "npx vitest run",
      "test_framework": "vitest",
      "file_ext": ".ts",
      "style_guide": "ESLint + Prettier + TS strict",
      "dep_file": "package.json",
      "dep_install": "npm install",
      "run_cmd_prefix": "npx ts-node",
      "dev_cmd": "npm run dev",
      "build_cmd": "npm run build",
      "lint_cmd": "npx eslint src/",
      "init_cmd": "npx vitest run --reporter=verbose",
      "gitignore_extra": "node_modules/\npackage-lock.json\n*.js.map\n.env"
    },
    "typescript-bun": {
      "lang": "typescript",
      "runtime": "bun",
      "runtime_check": "command -v bun",
      "version_check": "bun --version",
      "min_version": "1.0",
      "test_runner": "bun test",
      "test_framework": "bun:test",
      "file_ext": ".ts",
      "style_guide": "ESLint + Prettier + TS strict",
      "dep_file": "package.json",
      "dep_install": "bun install",
      "run_cmd_prefix": "bun",
      "dev_cmd": "bun run dev",
      "build_cmd": "bun run build",
      "lint_cmd": "bunx eslint src/",
      "init_cmd": "bun test",
      "gitignore_extra": "node_modules/\nbun.lockb\n*.js.map\n.env"
    },
    "php": {
      "lang": "php",
      "runtime": "php",
      "runtime_check": "command -v php",
      "version_check": "php --version",
      "min_version": "8.1",
      "test_runner": "./vendor/bin/phpunit",
      "test_framework": "phpunit",
      "file_ext": ".php",
      "style_guide": "PSR-12",
      "dep_file": "composer.json",
      "dep_install": "composer install",
      "run_cmd_prefix": "php",
      "dev_cmd": "php -S localhost:8000 -t public/",
      "build_cmd": "composer validate",
      "lint_cmd": "php -l src/",
      "init_cmd": "./vendor/bin/phpunit",
      "gitignore_extra": "vendor/\n.phpunit.result.cache\n.env"
    },
    "nextjs-node": {
      "lang": "nextjs",
      "runtime": "node",
      "runtime_check": "command -v node",
      "version_check": "node --version",
      "min_version": "18",
      "test_runner": "npx playwright test",
      "test_framework": "playwright",
      "file_ext": ".tsx",
      "style_guide": "ESLint + Prettier",
      "dep_file": "package.json",
      "dep_install": "npm install",
      "run_cmd_prefix": "npx next",
      "dev_cmd": "npx next dev",
      "build_cmd": "npx next build",
      "lint_cmd": "npx next lint",
      "init_cmd": "npx vitest run --reporter=verbose",
      "gitignore_extra": "node_modules/\n.next/\n.env.local\npackage-lock.json"
    },
    "nextjs-bun": {
      "lang": "nextjs",
      "runtime": "bun",
      "runtime_check": "command -v bun",
      "version_check": "bun --version",
      "min_version": "1.0",
      "test_runner": "bunx playwright test",
      "test_framework": "playwright",
      "file_ext": ".tsx",
      "style_guide": "ESLint + Prettier",
      "dep_file": "package.json",
      "dep_install": "bun install",
      "run_cmd_prefix": "bunx next",
      "dev_cmd": "bunx next dev",
      "build_cmd": "bunx next build",
      "lint_cmd": "bunx next lint",
      "init_cmd": "bun test",
      "gitignore_extra": "node_modules/\n.next/\n.env.local\nbun.lockb"
    }
  },
  "frameworks": {
    "react": {
      "framework": "react",
      "build_cmd": "npm run build",
      "dev_cmd": "npm run dev",
      "test_cmd": "npx vitest run",
      "lint_cmd": "npx eslint src/",
      "src_ext": ".tsx",
      "component_pattern": "*.tsx",
      "test_lib": "@testing-library/react",
      "compatible_languages": ["javascript-node", "javascript-bun", "typescript-node", "typescript-bun"]
    },
    "angular": {
      "framework": "angular",
      "build_cmd": "ng build",
      "dev_cmd": "ng serve",
      "test_cmd_ng": "ng test --watch=false",
      "test_cmd_jest": "ng test --watch=false --builder @angular-builders/jest",
      "test_runner_default_node": "jest",
      "test_runner_default_bun": "ng-test",
      "lint_cmd": "ng lint",
      "src_ext": ".ts",
      "component_pattern": "*.component.ts",
      "test_lib_ng": "Jasmine/Karma",
      "test_lib_jest": "@angular-builders/jest",
      "compatible_languages": ["typescript-node", "typescript-bun"]
    },
    "vue": {
      "framework": "vue",
      "build_cmd": "npm run build",
      "dev_cmd": "npm run dev",
      "test_cmd": "npx vitest run",
      "lint_cmd": "npx eslint src/",
      "src_ext": ".vue",
      "component_pattern": "*.vue",
      "test_lib": "@vue/test-utils",
      "compatible_languages": ["javascript-node", "javascript-bun", "typescript-node", "typescript-bun"]
    }
  }
}
